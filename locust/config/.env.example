# DocumentDB Connection Configuration
DOCDB_HOST=localhost
DOCDB_PORT=10260
DOCDB_USERNAME=your_username
DOCDB_PASSWORD=your_password
DOCDB_DATABASE=testdb
DOCDB_COLLECTION=testcollection

# TLS/SSL Configuration
DOCDB_TLS=false
DOCDB_TLS_CA_FILE=/path/to/ca-bundle.pem

# Connection Settings
DOCDB_RETRY_WRITES=false
DOCDB_READ_PREFERENCE=primary

# Locust Settings (optional)
LOCUST_USERS=10
LOCUST_SPAWN_RATE=1
LOCUST_RUN_TIME=5m
